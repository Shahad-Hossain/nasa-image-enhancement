        "# function for logarithm of a image\n",
        "def log(image_1: np.ndarray) -> np.ndarray:\n",
        "  # min height between height and height_2 so no normalization required\n",
        "  height, width = image_1.shape\n",
        "\n",
        "  new_image = np.zeros((height, width), dtype=np.uint8)\n",
        "\n",
        "  # ln(1 + x) for all numpy values in the image\n",
        "  log_transform = np.log1p(image_1)\n",
        "  max_val = np.max(log_transform)\n",
        "\n",
        "  for h in range(height):\n",
        "     for w in range(width):\n",
        "        # log_transform is the original image with every pixel being applied ln(1 + x)\n",
        "        pixel_value = log_transform[h][w]\n",
        "        # pixel logic makes changes more distinct by dividing by the max_val found in the ln(1 + x) and multiplying by 255\n",
